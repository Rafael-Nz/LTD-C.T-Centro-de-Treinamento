RewriteEngine On

# Impede acesso direto a arquivos sensíveis e código interno
RewriteRule ^(?:core|routes|src)/ - [F,L,NC]
<FilesMatch "\.(env|log|ini|yaml|yml|json)$">
    Require all denied
</FilesMatch>
<Files "openapi.json">
    Require all granted
</Files>

# Authorization header (JWT, etc)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Se existir arquivo ou pasta, não reescreve
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Roteamento principal
RewriteRule ^(.+)$ bootstrap.php?url=$1 [QSA,L]