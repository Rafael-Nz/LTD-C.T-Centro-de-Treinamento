APP_URL=http://localhost/ctt
APP_ENV=development
APP_ALLOWED_ORIGIN=http://localhost
# Em producao use APP_ENV=production. Documentacao Swagger so e publica com APP_ENV=development + APP_DOCS_PUBLIC=true + acesso via loopback.
APP_DOCS_PUBLIC=false
# IPs de proxies reversos confiaveis (separados por virgula) para aceitar X-Forwarded-Proto. Vazio = nao confiar.
APP_TRUSTED_PROXIES=
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=db_centro_treinamento
DB_USERNAME=ctt_app
# Defina uma senha forte da conta restrita antes de iniciar a aplicacao.
DB_PASSWORD=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Cross C.T"
