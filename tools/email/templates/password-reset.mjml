<mjml>
  <mj-head>
    <mj-title>Recuperação de senha</mj-title>
    <mj-preview
      >Solicitação para redefinir a senha da sua conta Cross C.T.</mj-preview
    >
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#4b5563" font-size="16px" line-height="1.6" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f3f4f6">
    <mj-section
      background-color="#141414"
      padding="24px 32px"
      border-top="5px solid #dc3545"
    >
      <mj-column>
        <mj-text
          color="#ffffff"
          font-size="24px"
          font-weight="700"
          letter-spacing="1px"
          padding="0"
        >
          CROSS <span style="color: #dc3545">C.T</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="36px 32px 16px">
      <mj-column>
        <mj-text
          color="#202124"
          font-size="24px"
          font-weight="700"
          padding-bottom="20px"
        >
          Redefinição de senha
        </mj-text>
        <mj-text color="#202124" padding-bottom="16px">Olá, {{nome}}.</mj-text>
        <mj-text padding-bottom="24px">
          Recebemos uma solicitação para redefinir a senha da sua conta. Clique
          no botão abaixo para continuar.
        </mj-text>
        <mj-button
          background-color="#dc3545"
          border-radius="6px"
          font-size="16px"
          font-weight="700"
          inner-padding="14px 24px"
          href="{{link}}"
        >
          Redefinir minha senha
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="0 32px 32px">
      <mj-column>
        <mj-divider border-color="#e5e7eb" padding="0 0 24px" />
        <mj-text
          color="#6b7280"
          font-size="13px"
          padding-top="0"
          padding-bottom="8px"
        >
          Este link expira em 15 minutos e só pode ser usado uma vez.
        </mj-text>
        <mj-text color="#6b7280" font-size="13px" padding-top="0">
          Se você não solicitou a alteração, ignore este e-mail. Sua senha
          continuará a mesma.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#f9fafb" padding="20px 32px">
      <mj-column>
        <mj-text align="center" color="#9ca3af" font-size="12px">
          Mensagem automática da Cross C.T. Não responda a este e-mail.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
