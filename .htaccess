# raiz/.htaccess
RewriteEngine On
RewriteBase /ctt/

# Arquivos de configuracao, SQL e ferramentas sao somente internos/CLI.
Options -Indexes
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:docs|tools|vendor)(?:/|$) - [F,L,NC]
RewriteRule ^(?:composer\.(?:json|lock)|README\.md)(?:/|$) - [F,L,NC]
<FilesMatch "(?i)(^\.env(?:\..*)?$|\.(?:sql|bak|backup|old)$)">
    Require all denied
</FilesMatch>

# 1. Ignorar a pasta de administração
RewriteRule ^admin($|/) - [L]
RewriteRule ^api($|/) - [L]

# Servir arquivos estáticos de public/
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|pdf|mp4|webm)$ [NC]
RewriteCond %{REQUEST_URI} !^/ctt/public/ [NC]
RewriteRule ^(.+)$ public/$1 [L]

# 2. Regra da API principal (Site/APP)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
